# ── Arbiter AI — Backend environment variables ────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# All variables have sensible defaults for local development; only DATABASE_URL
# and REDIS_URL are required to change in non-Docker local setups.

# ── API ────────────────────────────────────────────────────────────────────────
APP_TITLE=Arbiter AI
APP_VERSION=0.3.0
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all.
CORS_ORIGINS=["*"]

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (production / docker-compose):
DATABASE_URL=postgresql+asyncpg://arbiter:arbiter@localhost:5432/arbiter
# SQLite (local dev without Docker — aiosqlite driver required):
# DATABASE_URL=sqlite+aiosqlite:///./arbiter.db

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ────────────────────────────────────────────────────────────────────
# "local" stores uploads under LOCAL_STORAGE_PATH on the container/host.
# "s3"    streams uploads directly to S3 (requires S3_BUCKET + credentials).
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# S3 (only needed when STORAGE_BACKEND=s3):
# S3_BUCKET=my-arbiter-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Upload validation ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ── Security ───────────────────────────────────────────────────────────────────
# Per-IP fixed-window rate limits (requests/minute). Redis-backed when REDIS_URL
# is reachable; falls back to per-process in-memory counters otherwise.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_MINUTE=10
# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For:
TRUST_PROXY_HEADERS=false
# Enable when serving over HTTPS:
ENABLE_HSTS=false

# ── Computer vision ────────────────────────────────────────────────────────────
CV_MIN_ROWS=3
CV_CONFIDENCE_THRESHOLD=0.55
CV_BLANK_CELL_THRESHOLD=0.97
CV_HEADER_ROWS=1

# ── OCR ────────────────────────────────────────────────────────────────────────
# "claude"    — Claude Vision API, full-sheet reading (production, highest accuracy)
# "trocr"     — microsoft/trocr-large-handwritten (offline fallback, GPU recommended)
# "tesseract" — dev/comparison only
OCR_BACKEND=claude

# Claude Vision OCR (required when OCR_BACKEND=claude):
# Get a key at https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=
CLAUDE_OCR_MODEL=claude-sonnet-4-6
CLAUDE_OCR_MAX_IMAGE_EDGE=2576
# Fall back to local TrOCR if the Claude API call fails:
OCR_FALLBACK_TO_TROCR=true

TROCR_MODEL_ID=microsoft/trocr-large-handwritten
TROCR_MAX_BATCH_SIZE=32
TROCR_NUM_CANDIDATES=3
OCR_CONFIDENCE_THRESHOLD=0.85

# ── Dev helpers ────────────────────────────────────────────────────────────────
# Set to true to auto-create DB tables on startup (dev only).
# Production should use: alembic upgrade head
AUTO_CREATE_TABLES=true
